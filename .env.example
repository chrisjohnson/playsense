# ---- Spotify OAuth ----
# NOTE: Spotify client credentials are set via the web UI (Home tab) and stored in
# ~/.spotify-tracker/credentials.json (bind-mounted at /spotify-tracker). The env
# vars below are optional fallbacks only. Create an app at
# https://developer.spotify.com/dashboard/create and set its Redirect URI to
# https://local-ai-machine.local:6111/api/oauth/redirect.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APP_PUBLIC_URL=https://local-ai-machine.local:6111
SPOTIFY_REDIRECT_URI=https://local-ai-machine.local:6111/api/oauth/redirect
# Scopes requested at auth time (comma separated). Add playlist-modify-* for push-back.
SPOTIFY_SCOPES=user-read-private,user-read-email,playlist-read-private,playlist-read-collaborative,playlist-modify-public,playlist-modify-private

# ---- Database ----
DATABASE_URL=sqlite:///./spotify_tracker.db

# ---- Inference / hosted models (OpenAI-compatible HTTP endpoint) ----
# Default points at an Ollama server on the host machine. Override for vLLM/LM Studio/etc.
INFERENCE_BASE_URL=http://host.docker.internal:11434/v1
INFERENCE_API_KEY=sk-not-needed-for-ollama
INFERENCE_MODEL=llama3.1:8b
INFERENCE_TIMEOUT_SECONDS=60
# Confidence >= this -> accept structured/keyword result without LLM.
SEMANTIC_CONFIDENCE_THRESHOLD=0.85

# ---- App ----
WORKER_CONCURRENCY=4
SECRET_KEY=change-me-to-a-random-string
